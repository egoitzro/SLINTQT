import { ThemeEngine } from "cute_theme.slint";

export component CuteStatusBar inherits Rectangle {
    in property <string> status_text: "Ready";
    height: 28px;
    background: transparent;
    
    Rectangle {
        y: 0;
        height: 1px;
        width: parent.width;
        background: ThemeEngine.border_subtle;
    }
    
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: space-between;
        
        Text {
            text: root.status_text;
            color: ThemeEngine.text_secondary;
            font-size: 12px;
            vertical-alignment: center;
        }
        
        HorizontalLayout {
            alignment: end;
            @children
        }
    }
}
